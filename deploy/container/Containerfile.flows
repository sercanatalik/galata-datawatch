# The scheduling lane: cereyan, the flows that give the record's maintenance
# its cadence, and the release binaries those flows spawn. Built from the
# repository root:
#
#   scripts/build-images.sh
#   container build -t galata-flows -f deploy/container/Containerfile.flows .
#
# **Laid out as the checkout is.** A flow finds its tools and its
# configuration from its own file's location (py/flows/_runner.py): the
# release directory two folders up, the configuration beside it. So /app/py,
# /app/target/release and /app/config are where a checkout has them, and the
# runner is not taught that it is in a container.
#
# **Six flows, not eight.** `derive-the-signals` and `update-the-reference`
# are left out, with the signals environment they need; the EWMA covariance
# is computed by `derive-the-covariance` in Rust instead (add-galata-quant).
# That environment pins galata-research by an absolute path on one machine.
# A flow that is not in the image is not registered, so it is neither
# scheduled nor startable: registration is the exposure boundary
# (py/flows/__init__.py). Both stay in the tree, untouched.
#
# **No secret, as natively.** The lane holds no credential and is handed
# none; this image has no `with-secrets`, because nothing is handed over.
#
# The same build stage as deploy/container/Containerfile, to the letter, so
# the two images share its layers and cannot be built from different trees.

FROM rust:1.98.1-bookworm AS build
WORKDIR /src
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
# And galata-quant-signals (add-galata-quant): the EWMA covariance in Rust,
# which fetches galata-quant from GitHub by its tag.
RUN cargo build --release --locked -p galata-datawatch --bins -p galata-signals \
 && mkdir /out \
 && cp target/release/galata-datawatch target/release/galata-ledger \
       target/release/galata-compact target/release/galata-tape-rebuild \
       target/release/galata-retain target/release/galata-watch \
       target/release/galata-derive target/release/galata-signals-commit \
       target/release/galata-quant-signals /out/

FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home galata \
 && mkdir -p /app/py/flows /app/var /app/config /app/target/release /data \
 && chown -R galata /app /data

# The lane's own environment, from its lock; --frozen, so a build never moves
# a pin.
WORKDIR /app/py
COPY py/pyproject.toml py/uv.lock py/cereyan.toml ./
RUN uv sync --frozen --no-dev

# The flows by name, never the folder: a flow copied here is a flow anyone
# who reaches the lane can start.
COPY py/flows/__init__.py py/flows/_runner.py py/flows/compact.py \
     py/flows/project.py py/flows/rebuild.py py/flows/retain.py \
     py/flows/watch.py py/flows/covariance.py ./flows/
# The declared horizons derive-the-covariance reads; py/signals' environment
# is not here.
COPY py/signals/signals.toml ./signals/signals.toml
COPY --from=build /out/ /app/target/release/

ARG SOURCE_TREE=unknown
LABEL org.galata.source-tree=$SOURCE_TREE

# Its own home, as natively (a shared one imports other projects' flows), in
# the volume the launcher gives it. The interface listens inside the
# container only: it can start any registered flow, so it is never published.
ENV CEREYAN_HOME=/data/cereyan \
    CEREYAN_NO_BROWSER=1 \
    NO_COLOR=1 \
    PATH=/app/py/.venv/bin:$PATH
USER galata
CMD ["cereyan", "serve", ".", "--no-open", "--host", "127.0.0.1", "--port", "4200"]
