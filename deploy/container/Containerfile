# galata-datawatch's binaries, for a service that runs in a container of its
# own (README, "Services in containers"). Built from the repository root:
#
#   scripts/build-images.sh
#   container build -t galata-datawatch -f deploy/container/Containerfile .
#
# **Linux on Apple silicon, glibc.** Debian bookworm on both stages, as
# galata-watcher's image is: rustls's aws-lc-rs has a C build, and that is
# the fragile part on musl.
#
# **No vault tooling and no secret.** A service's launcher reads its secrets
# on the host, with that service's own token, and writes them to the
# container's standard input, where `with-secrets` receives them
# (scripts/run-service.sh). So this builds `-p galata-datawatch` alone: the
# vault member, and the 149 packages it adds, never enter the image.
#
# **No configuration and no record.** `var/` is outside the build context
# (.dockerignore). The deployment's configuration and each service's own
# roots are mounted when it starts.

FROM rust:1.98.1-bookworm AS build
WORKDIR /src
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
# With `derive-xyz`, so `galata-ledger derive-xyz` runs from this image
# (add-derive-account-ledger, design D8). It adds the Derive adapter and its
# signer, secp256k1 and keccak-256, and nothing a running service is not
# configured to use.
RUN cargo build --release --locked -p galata-datawatch --bins --features derive-xyz \
 && mkdir /out \
 && cp target/release/galata-datawatch target/release/galata-ledger \
       target/release/galata-compact target/release/galata-tape-rebuild \
       target/release/galata-retain target/release/galata-watch \
       target/release/galata-derive target/release/galata-signals-commit /out/

FROM debian:bookworm-slim
# The venues answer over TLS, and the roots are the system's.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home galata \
 && mkdir -p /app/var /app/config && chown -R galata /app
COPY --from=build /out/ /usr/local/bin/
# How a secret enters: over standard input, never `-e` (see the script).
COPY --chmod=755 deploy/container/with-secrets /usr/local/bin/with-secrets
# The tree this image was built from. `install-services.sh --status` reports
# it beside a running container, so a deployed image is never anonymous.
ARG SOURCE_TREE=unknown
LABEL org.galata.source-tree=$SOURCE_TREE
# /app stands where the checkout does: the configuration's relative `var/…`
# paths mean in a container what they mean from a shell at the repo root.
WORKDIR /app
USER galata
