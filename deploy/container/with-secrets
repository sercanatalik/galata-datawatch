#!/bin/sh
#
# Receive a service's secrets, then become the service.
#
#   with-secrets NAME [NAME ...] -- program [argument ...]
#
# Reads `NAME=value` lines from standard input until it closes, exports each
# NAME it was told to expect, and is replaced by the program. The launcher on
# the host writes those lines (scripts/lib/hand-secrets.sh); this is the only
# door by which a secret enters a container.
#
# **Why standard input and not `container run -e NAME`.** Measured 2026-11-24,
# Apple container 1.7.1: a value passed with `-e` is written to two files
# under the container tool's state, mode 0644, for as long as the container
# exists, and `container inspect` prints it. A value written to standard
# input is in neither, and in no host process's arguments or environment.
#
# **Only the names it was told.** A name nobody asked for is refused, and so
# is an expected name that never arrives: a service started without its
# password looks, for a while, exactly like one started with it.
#
# **Nothing it prints holds a value.** A line that does not start with a name
# may be the second half of a value with a line break in it, so such a line
# is refused without being echoed.
#
# `exec`, so the service is the container's process and a stop reaches it.

set -eu

me=with-secrets
refuse() { echo "$me: REFUSED — $1" >&2; exit 2; }

expected=""
while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case "$1" in
        ''|[0-9]*|*[!A-Za-z0-9_]*) refuse "'$1' cannot be the name of a variable" ;;
    esac
    expected="$expected $1"
    shift
done
[ "${1:-}" = -- ] || refuse "usage: $me NAME [NAME ...] -- program [argument ...]"
shift
[ $# -gt 0 ] || refuse "usage: $me NAME [NAME ...] -- program [argument ...]"
[ -n "$expected" ] || refuse "no name to expect; a service with no secret is started without $me"

arrived=""
# `|| [ -n "$line" ]`: a last line with no newline after it still counts.
while IFS= read -r line || [ -n "$line" ]; do
    name="${line%%=*}"
    # No `=` at all, or what precedes it is not a name: say so, and nothing
    # of the line.
    if [ "$name" = "$line" ]; then
        refuse "a line of standard input names no variable"
    fi
    case "$name" in
        ''|[0-9]*|*[!A-Za-z0-9_]*) refuse "a line of standard input names no variable" ;;
    esac
    case " $expected " in
        *" $name "*) ;;
        *) refuse "was handed $name, which this service did not ask for" ;;
    esac
    case " $arrived " in
        *" $name "*) refuse "was handed $name twice" ;;
    esac
    [ -n "${line#*=}" ] || refuse "$name arrived empty"
    export "$line"
    arrived="$arrived $name"
done

for name in $expected; do
    case " $arrived " in
        *" $name "*) ;;
        *) refuse "$name never arrived on standard input" ;;
    esac
done

exec "$@"
